    {"id":"sections-b","team":"build","goal":"Build FAQ, clearly marked examples if any, and closing CTA.","reads":["structure.md","site/content.json","site/tokens.css"],"writes":["site/sections/closing.html"]},
    {"id":"nav-footer","team":"build","goal":"Build accessible navigation, mobile menu, and footer.","reads":["BRIEF.md","structure.md","site/content.json"],"writes":["site/sections/nav.html","site/sections/footer.html"]},
    {"id":"forms","team":"polish","goal":"Implement progressive form enhancement, validation and safe feedback states.","reads":["structure.md","site/content.json"],"writes":["site/app.js"]},
    {"id":"motion","team":"polish","goal":"Add restrained animation with reduced-motion support.","reads":["brand.md","site/layout.css"],"writes":["site/motion.css"]},
