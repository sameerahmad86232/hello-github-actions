    {"id":"seo","team":"base","goal":"Set SEO titles, metadata, heading outline and honest schema guidance.","reads":["BRIEF.md","structure.md","site/content.json"],"writes":["seo.md"]},
    {"id":"type-tokens","team":"base","goal":"Create the two-family maximum typography, spacing and color token system.","reads":["brand.md","BRIEF.md","site/tokens.css"],"writes":["site/tokens.css"]},
    {"id":"layout-grid","team":"base","goal":"Create mobile-first shells and grids without horizontal overflow.","reads":["structure.md","site/tokens.css"],"writes":["site/layout.css"]},
