    {"id":"performance","team":"ship","goal":"Audit image, font, script weight and layout shift risks.","reads":["site/","BRIEF.md"],"writes":["reports/performance.md"],"reviewOnly":true},
    {"id":"security","team":"ship","goal":"Audit secrets, unsafe scripting, forms and external dependencies.","reads":["site/","BRIEF.md"],"writes":["reports/security.md"],"reviewOnly":true},
